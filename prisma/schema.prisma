// Prisma schema for Hatchloop AEO session storage + scan cache.
// Run `npx prisma migrate dev` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Shopify OAuth session storage (required by @shopify/shopify-app-session-storage-prisma) ──
model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  firstName   String?
  lastName    String?
  email       String?
  accountOwner Boolean  @default(false)
  locale      String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
}

// ── Cached AEO scan results (public + authenticated) ──
model ScanResult {
  id            String   @id @default(cuid())
  shop          String
  scanType      String   // "public" | "authenticated"
  score         Int
  grade         String
  reportJson    String   // full JSON report blob
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop])
}

// ── Citation tracking prompts (Pro tier) ──
model TrackedPrompt {
  id        String   @id @default(cuid())
  shop      String
  prompt    String
  engines   String   // comma-separated: chatgpt,perplexity,gemini,copilot
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  results   PromptResult[]

  @@index([shop])
}

model PromptResult {
  id        String   @id @default(cuid())
  promptId  String
  prompt    TrackedPrompt @relation(fields: [promptId], references: [id])
  engine    String
  cited     Boolean
  excerpt   String?
  checkedAt DateTime @default(now())

  @@index([promptId])
}
