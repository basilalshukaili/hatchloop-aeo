{% comment %}
  Hatchloop AEO — Theme App Extension: Schema Injection Block
  Injects Product, Offer, AggregateRating, Organization, BreadcrumbList,
  and (on FAQ pages) FAQPage JSON-LD into the storefront theme.

  This block is injected via the Theme App Extension mechanism — no theme
  code is modified and the block is cleanly removed on app uninstall.

  SCAFFOLD: The metafield namespaces (hatchloop_aeo.*) need to be registered
  via the Admin API before this block reads live data. The block renders
  sensible fallbacks from native Liquid objects in the meantime.
{% endcomment %}

{%- liquid
  assign aeo_product = product
  assign aeo_org_name = shop.name
  assign aeo_org_url  = shop.url
-%}

{%- if aeo_product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ aeo_product.title | json }},
  "description": {{ aeo_product.description | strip_html | json }},
  "url": "{{ shop.url }}{{ aeo_product.url }}",
  "sku": {{ aeo_product.selected_or_first_available_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ aeo_product.vendor | json }}
  },
  {%- if aeo_product.featured_image -%}
  "image": [
    "{{ aeo_product.featured_image | image_url: width: 1200 }}"
  ],
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ aeo_product.selected_or_first_available_variant.price | money_without_currency }}",
    "availability": "{% if aeo_product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ aeo_product.url }}",
    "seller": {
      "@type": "Organization",
      "name": {{ aeo_org_name | json }}
    }
  }
  {%- if aeo_product.metafields.reviews.rating -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ aeo_product.metafields.reviews.rating.value | times: 1 }}",
    "reviewCount": "{{ aeo_product.metafields.reviews.rating_count }}"
  }
  {%- endif -%}
}
</script>
{%- endif -%}

{%- comment %} Organization schema — injected on every page {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ aeo_org_name | json }},
  "url": {{ aeo_org_url | json }}
  {%- if shop.metafields.hatchloop_aeo.org_logo -%}
  ,"logo": "{{ shop.metafields.hatchloop_aeo.org_logo }}"
  {%- endif -%}
}
</script>

{%- comment -%}
  BreadcrumbList — injected when template is product or collection
{%- endcomment -%}
{%- if template contains 'product' or template contains 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {%- if collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": "{{ shop.url }}{{ collection.url }}"
    }
    {%- endif -%}
    {%- if aeo_product -%}
    ,{
      "@type": "ListItem",
      "position": {% if collection %}3{% else %}2{% endif %},
      "name": {{ aeo_product.title | json }},
      "item": "{{ shop.url }}{{ aeo_product.url }}"
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%}
  FAQPage schema — injected when the hatchloop_aeo.faq_json metafield is set
  (Starter/Pro: the app writes this metafield via Admin API after merchant review)
{%- endcomment -%}
{%- if shop.metafields.hatchloop_aeo.faq_json -%}
<script type="application/ld+json">
{{ shop.metafields.hatchloop_aeo.faq_json.value }}
</script>
{%- endif -%}
