# Copy this to apps/aeo-app/.env and fill in the real values.
# NEVER commit .env to source control.
#
# The real SHOPIFY_APP_CLIENT_ID and SHOPIFY_APP_SECRET live in the root
# .env (C:\ai company\.env). Copy them here under the Shopify-app-remix
# expected names (SHOPIFY_API_KEY / SHOPIFY_API_SECRET).

# ── Shopify OAuth (from root .env SHOPIFY_APP_CLIENT_ID / SHOPIFY_APP_SECRET) ──
SHOPIFY_API_KEY=816ae50a396e9474ba4ea40d722908a6
SHOPIFY_API_SECRET=REPLACE_WITH_SHOPIFY_APP_SECRET

# ── Public app URL (Cloudflare tunnel for dev, production hostname for prod) ──
# Get a free tunnel with: npx cloudflared tunnel --url http://localhost:3000
# Then paste the https://xxxx.trycloudflare.com URL here AND in shopify.app.toml
# AND in Partner Dashboard > App setup > App URL + Allowed redirect URLs.
SHOPIFY_APP_URL=https://REPLACE_WITH_YOUR_TUNNEL_OR_PROD_URL

# ── Session / Database ──
DATABASE_URL="file:./dev.db"

# ── Auth mode ──
# "mock"    — no real store needed; public scan still runs against MOCK_SCAN_URL.
# "shopify" — full OAuth; requires real credentials and a live tunnel/host above.
AUTH_MODE=mock

# ── Mock scan target (used only when AUTH_MODE=mock) ──
MOCK_SCAN_URL=https://allbirds.com

# ── Bill-safety caps (do not increase without review) ──
MAX_SCAN_FETCHES=6
SCAN_DEADLINE_MS=22000
